# Copy to .env.local. Never commit real credentials.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://veehoster.com
DATABASE_PATH=./data/veehoster.sqlite
PAYMENT_MODE=demo
# Demo is enabled by default; no payment details or keys are required.
# PAYU_KEY=
# PAYU_SALT=
# PayU sandbox is supported after configuring credentials and HTTPS callbacks.
# PAYMENT_MODE=payu_sandbox
# Set only behind a correctly configured trusted reverse proxy:
TRUST_PROXY=false
# Development reset tokens go to data/mailbox.jsonl. Production reset emails
# require the documented email credentials before enabling delivery.

# Live checkout is deliberately off. Review docs/PAYU.md before enabling.
LIVE_CHECKOUT_ENABLED=false
# PAYMENT_MODE=payu_live
# Optional transactional password reset email (Resend):
# MAIL_API_KEY=
# MAIL_FROM=Veehoster <accounts@veehoster.com>
