{
  "name": "veehoster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/payment.test.mjs",
    "test:e2e": "playwright test",
    "admin": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "format": "prettier --write app components lib scripts tests docs *.json *.ts *.md",
    "format:check": "prettier --check app components lib scripts tests docs *.json *.ts *.md"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "^1.13.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
